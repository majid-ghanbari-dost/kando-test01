+++ b/kandoo-intent-dataset/v0.2/schemas/record_schema.json
@@ -0,0 +1,131 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "kandoo-intent-dataset/v0.2/schemas/record_schema.json",
+  "title": "Kandoo Intent Dataset v0.2 - record schema",
+  "description": "Structural schema of one JSONL record. Formalizes the SAME rules that scripts/validate_batch.py (Stage A) enforces on every record. Two semantic rules CANNOT be expressed in JSON Schema and are enforced by the QC scripts instead: (1) entity values must be evidenced in the text (Stage A/C - scripts/stage_c_semantic_pass.py), (2) depends_on must reference a PREVIOUS slot index (0 <= d < i) and chained slots must not repeat the chained entity explicitly (M-0024 rule, Stage C).",
+  "type": "object",
+  "required": ["id", "text", "task_type", "intents", "candidate_intents", "needs_clarification", "clarification_reason", "clarification_question", "review_status"],
+  "additionalProperties": false,
+  "properties": {
+    "id": {
+      "type": "string",
+      "pattern": "^KND-(S|M|A|O)-\\d{4}$",
+      "description": "S=single, M=multi, A=ambiguous, O=out_of_scope. Sequential per prefix; the only documented gap is KND-A-0008 (allocated in the overwritten batch-07 draft, never reused)."
+    },
+    "text": {
+      "type": "string",
+      "minLength": 3,
+      "description": "Original Persian utterance, kept verbatim (typos, colloquial forms and pinglish included by ratified convention)."
+    },
+    "task_type": {
+      "type": "string",
+      "enum": ["single", "multi", "ambiguous", "out_of_scope"]
+    },
+    "intents": {
+      "type": "array",
+      "description": "Ordered execution slots. Exactly 1 for single, >=2 for multi, empty for ambiguous and out_of_scope.",
+      "items": {
+        "type": "object",
+        "required": ["intent", "entities", "depends_on"],
+        "additionalProperties": false,
+        "properties": {
+          "intent": {
+            "type": "string",
+            "enum": ["GET_SALES_REPORT", "GET_PRODUCT_SALES", "GET_PRODUCT_STOCK", "GET_LOW_STOCK", "SEARCH_PRODUCT", "GET_LAST_INVOICE", "SEARCH_INVOICE", "GET_CUSTOMER_INFO", "SEARCH_CUSTOMER", "GET_TOP_PRODUCTS", "GET_SALES_COMPARISON", "GET_DAILY_SUMMARY"]
+          },
+          "entities": {
+            "type": "object",
+            "description": "Values must be verbatim substrings of the text (checked by Stage A/C), except: date/date_range/period_a/period_b hold standard tokens or evidenced phrases, limit holds a Latin-digit integer.",
+            "additionalProperties": false,
+            "properties": {
+              "product_name": { "type": "string", "minLength": 1, "description": "Canonical product name (typo/colloquial exceptions registered in _progress.json canonical_value_exceptions)." },
+              "customer_name": { "type": "string", "minLength": 1, "description": "Customer name without honorifics." },
+              "customer_id": { "type": "string", "pattern": "^[0-9]+$" },
+              "phone": { "type": "string", "pattern": "^[0-9]+$" },
+              "invoice_number": { "type": "string", "pattern": "^[0-9]+$" },
+              "date": { "type": "string", "description": "Standard token (today|yesterday|this_week|last_week|this_month|last_month|this_year|last_year) or digit-bearing specific date." },
+              "date_range": { "type": "string", "description": "Standard token or verbatim phrase (the 9 documented warnings keep phrases verbatim)." },
+              "period_a": { "type": "string" },
+              "period_b": { "type": "string" },
+              "limit": { "type": "integer", "minimum": 1, "description": "Ranking/quantity limit, Latin digits, must be evidenced in text (word-numbers allowed)." }
+            }
+          },
+          "depends_on": {
+            "type": ["integer", "null"],
+            "minimum": 0,
+            "description": "0-based index of the PREREQUISITE slot inside the same intents array; must be a PREVIOUS slot (d < i); null for independent slots; always null in single records. Enforced by Stage A/C."
+          }
+        }
+      }
+    },
+    "candidate_intents": {
+      "type": "array",
+      "description": "Competing interpretations; >=2 entries for ambiguous records, empty for all other task types.",
+      "items": { "type": "string", "enum": ["GET_SALES_REPORT", "GET_PRODUCT_SALES", "GET_PRODUCT_STOCK", "GET_LOW_STOCK", "SEARCH_PRODUCT", "GET_LAST_INVOICE", "SEARCH_INVOICE", "GET_CUSTOMER_INFO", "SEARCH_CUSTOMER", "GET_TOP_PRODUCTS", "GET_SALES_COMPARISON", "GET_DAILY_SUMMARY"] }
+    },
+    "needs_clarification": {
+      "type": "boolean",
+      "description": "true for: all ambiguous records; single records missing a required parameter (25 records); one multi record with an unresolved second-slot reference (KND-M-0053). Total 49."
+    },
+    "clarification_reason": {
+      "type": ["string", "null"],
+      "description": "Persian free-text reason; non-null iff needs_clarification=true. Stage-A additionally whitelists 10 reason categories used at production time (see DATASET_DOCUMENTATION.md)."
+    },
+    "clarification_question": {
+      "type": ["string", "null"],
+      "description": "Persian clarification question; non-null iff needs_clarification=true."
+    },
+    "review_status": {
+      "type": "string",
+      "enum": ["seed_needs_review", "auto_validated", "human_verified", "rejected"],
+      "description": "Every v0.2 record ships as seed_needs_review; human verification is pending (144-record priority list in reports/human_review_priority.json)."
+    },
+    "oos_category": {
+      "type": "string",
+      "enum": ["weather", "news", "entertainment", "general_knowledge", "tutoring", "creative_writing", "finance_crypto", "general_advice", "car_repair", "design", "unsupported_business_feature", "chitchat"],
+      "description": "Present ONLY on out_of_scope records."
+    }
+  },
+  "allOf": [
+    {
+      "if": { "properties": { "task_type": { "const": "out_of_scope" } } },
+      "then": {
+        "required": ["oos_category"],
+        "properties": {
+          "intents": { "maxItems": 0 },
+          "candidate_intents": { "maxItems": 0 },
+          "needs_clarification": { "const": false }
+        }
+      }
+    },
+    {
+      "if": { "properties": { "task_type": { "const": "ambiguous" } } },
+      "then": {
+        "properties": {
+          "intents": { "maxItems": 0 },
+          "candidate_intents": { "minItems": 2 },
+          "needs_clarification": { "const": true }
+        }
+      }
+    },
+    {
+      "if": { "properties": { "task_type": { "const": "single" } } },
+      "then": {
+        "properties": {
+          "intents": { "minItems": 1, "maxItems": 1 },
+          "candidate_intents": { "maxItems": 0 },
+          "intents": { "items": { "properties": { "depends_on": { "const": null } } } }
+        }
+      }
+    },
+    {
+      "if": { "properties": { "task_type": { "const": "multi" } } },
+      "then": {
+        "properties": {
+          "intents": { "minItems": 2 },
+          "candidate_intents": { "maxItems": 0 }
+        }
+      }
+    }
+  ]
+}
