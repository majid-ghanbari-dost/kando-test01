+                pairs.append({'similarity': round(s, 3),
+                              'a': recs[i]['id'], 'b': recs[j]['id'],
+                              'task_type_a': recs[i]['task_type'],
+                              'task_type_b': recs[j]['task_type'],
+                              'text_a': recs[i]['text'], 'text_b': recs[j]['text']})
+    pairs.sort(key=lambda p: -p['similarity'])
+
+    sig = lambda r: (r['task_type'], tuple(sorted(s['intent'] for s in r.get('intents', []))),
+                     tuple(sorted(r.get('candidate_intents', []))))
+    sigmap = {}
+    for i, r in enumerate(recs):
+        sigmap.setdefault(sig(r), []).append(i)
+    max_same, max_pair = 0.0, None
+    for k, idxs in sigmap.items():
+        for a in range(len(idxs)):
+            for b in range(a + 1, len(idxs)):
+                s = similarity(norm[idxs[a]], norm[idxs[b]])
+                if s > max_same:
