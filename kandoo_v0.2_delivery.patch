+def run_stage(script, args=()):
+    """Run a sibling QC script, capture console output + exit code."""
+    cmd = [sys.executable, os.path.join(SCRIPT_DIR, script)] + list(args)
+    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
+    return {'command': ' '.join(os.path.basename(c) if i == 0 else c for i, c in enumerate(cmd)),
+            'exit_code': proc.returncode,
+            'stdout': proc.stdout, 'stderr': proc.stderr}
+
+
+# ================================================================ 1. file integrity
+def file_integrity():
+    out = {'final_file': {
+        'path': os.path.relpath(DATASET, V02_DIR),
+        'sha256': sha256_of(DATASET),
+        'bytes': os.path.getsize(DATASET),
+        'utf8_valid': True,  # proven below by reading every line
+    }}
+    try:
+        with open(DATASET, 'rb') as f:
+            f.read().decode('utf-8')
+    except UnicodeDecodeError as exc:
+        out['final_file']['utf8_valid'] = False
+        out['final_file']['utf8_error'] = str(exc)
+
+    batch_files = []
+    concat_lines = []
+    for name in sorted(os.listdir(BATCHES_DIR)):
+        if not name.endswith('.jsonl'):
+            continue
+        p = os.path.join(BATCHES_DIR, name)
+        _r, invalid = load_jsonl(p)
+        batch_files.append({'path': 'batches/' + name, 'sha256': sha256_of(p),
+                            'records': len(_r), 'invalid_json_lines': len(invalid)})
+        with open(p, encoding='utf-8') as f:
+            concat_lines.extend(l.rstrip('\n') for l in f if l.strip())
+    out['batch_files'] = batch_files
+    out['batch_concat_record_count'] = len(concat_lines)
+
+    with open(DATASET, encoding='utf-8') as f:
+        final_lines = [l.rstrip('\n') for l in f if l.strip()]
+    out['final_file']['records'] = len(final_lines)
+    out['concat_equals_final_exact_bytes'] = concat_lines == final_lines
+
+    # record-level (order-insensitive id multiset) equivalence as second view
+    ids_concat = Counter(json.loads(l)['id'] for l in concat_lines)
+    ids_final = Counter(json.loads(l)['id'] for l in final_lines)
+    out['concat_equals_final_id_multiset'] = ids_concat == ids_final
+
+    rej = []
+    if os.path.isdir(REJECTED_DIR):
+        for name in sorted(os.listdir(REJECTED_DIR)):
+            p = os.path.join(REJECTED_DIR, name)
+            r, _ = load_jsonl(p)
+            rej.append({'path': 'rejected_drafts/' + name, 'sha256': sha256_of(p),
+                        'records': len(r),
+                        'note': 'rejected production draft - NOT part of the final dataset '
+                                '(see _progress.json qc_incidents)'})
+    out['rejected_drafts'] = rej
+    return out
+
