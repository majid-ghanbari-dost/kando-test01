+    # same signature -> register/template variant (final adjudication is human)
+    def classify(p):
+        ia, ib = next(r for r in recs if r['id'] == p['a']), next(r for r in recs if r['id'] == p['b'])
+        return 'designed minimal pair (different labels)' if sig(ia) != sig(ib) \
