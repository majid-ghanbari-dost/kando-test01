+# ================================================================ multi-intent audit (independent)
+def multi_intent_audit(recs):
+    multi = [r for r in recs if r['task_type'] == 'multi']
+    hist = Counter(len(r['intents']) for r in multi)
+
+    chains, legality_errors, cycle_errors, m0024_violations = [], [], [], []
+
+    def has_cycle(r):
+        n = len(r['intents'])
+        edges = {i: s.get('depends_on') for i, s in enumerate(r['intents'])}
+        for start in range(n):
+            seen, cur = set(), start
+            while cur is not None:
+                if cur in seen:
+                    return True
+                seen.add(cur)
+                cur = edges[cur]
+        return False
+
+    for r in multi:
+        slots = r['intents']
+        dep_idx = [i for i, s in enumerate(slots) if s.get('depends_on') is not None]
+        if dep_idx:
+            chains.append({
+                'id': r['id'],
+                'text': r['text'],
+                'slots': [{'i': i, 'intent': s['intent'],
+                           'depends_on': s.get('depends_on'),
+                           'entities': s.get('entities') or {}} for i, s in enumerate(slots)],
+            })
+        for i, s in enumerate(slots):
+            d = s.get('depends_on')
+            if d is None:
+                continue
+            if not isinstance(d, int):
+                legality_errors.append({'id': r['id'], 'slot': i, 'error': 'non-integer depends_on %r' % d})
+                continue
+            if not (0 <= d < len(slots)):
+                legality_errors.append({'id': r['id'], 'slot': i, 'error': 'out-of-range index %d' % d})
+            elif d >= i:
+                legality_errors.append({'id': r['id'], 'slot': i, 'error': 'forward/self reference: slot %d depends on %d (must be a PREVIOUS slot)' % (i, d)})
+            else:
+                carried = CHAINABLE & set((s.get('entities') or {}).keys())
+                if carried:
+                    m0024_violations.append({'id': r['id'], 'slot': i,
+                                             'error': 'chained slot carries explicit entity %s (M-0024 rule: explicit entity => independent)' % sorted(carried)})
+        if has_cycle(r):
+            cycle_errors.append({'id': r['id'], 'error': 'circular depends_on chain'})
+
+    repeated = []
+    for r in multi:
+        labs = [s['intent'] for s in r['intents']]
+        if len(labs) != len(set(labs)):
+            ent_sig = [json.dumps(s.get('entities') or {}, sort_keys=True, ensure_ascii=False) for s in r['intents']]
+            repeated.append({'id': r['id'], 'intents': labs, 'entity_signatures': ent_sig,
+                             'distinct_entities': len(set(ent_sig)) == len(ent_sig) and len(set(labs)) < len(labs)})
+
+    multi_nc = [{'id': r['id'], 'text': r['text'],
+                 'needs_clarification': r['needs_clarification'],
+                 'clarification_reason': r.get('clarification_reason'),
+                 'clarification_question': r.get('clarification_question')}
+                for r in multi if r.get('needs_clarification')]
+
+    multi_dep = [r['id'] for r in multi
+                 if sum(1 for s in r['intents'] if s.get('depends_on') is not None) >= 2]
+
+    return {
+        'slot_histogram': {str(k): v for k, v in sorted(hist.items())},
+        'two_slot_records': hist.get(2, 0),
+        'three_slot_records': hist.get(3, 0),
+        'four_slot_records': hist.get(4, 0),
+        'five_slot_records': hist.get(5, 0),
+        'dependency_chains': {'count': len(chains), 'records': chains},
+        'multi_dependent_records': {'count': len(multi_dep), 'ids': multi_dep},
+        'repeated_intent_records': {'count': len(repeated), 'records': repeated},
+        'multi_plus_nc': {'count': len(multi_nc), 'records': multi_nc},
+        'depends_on_legality_errors': legality_errors,
+        'depends_on_cycles': cycle_errors,
+        'm0024_rule_violations': m0024_violations,
+        'result': 'PASS' if not legality_errors and not cycle_errors and not m0024_violations else 'FAIL',
+        'pass_criteria': 'every depends_on is an integer index of a PREVIOUS slot (d < i), '
+                         'no cycles (guaranteed by d<i but verified by DFS anyway), and no '
+                         'chained slot carries an explicit chainable entity (M-0024 rule)',
+    }
+
+
+# ================================================================ statistics
+def dataset_statistics(recs, ledger):
+    by_tt = Counter(r['task_type'] for r in recs)
+    slot_intents = Counter(s['intent'] for r in recs for s in r.get('intents', []))
+    ent_types = Counter(k for r in recs for s in r.get('intents', []) for k in (s.get('entities') or {}))
+    date_vals = Counter(str(v) for r in recs for s in r.get('intents', [])
+                        for k, v in (s.get('entities') or {}).items() if k in DATE_FIELDS and v)
+    nc_by_tt = Counter(r['task_type'] for r in recs if r.get('needs_clarification'))
+    nc_reasons = Counter(r.get('clarification_reason') for r in recs if r.get('needs_clarification'))
+    cand_pairs = Counter(' + '.join(sorted(r['candidate_intents'])) for r in recs if r['task_type'] == 'ambiguous')
+    oos_cats = Counter(r['oos_category'] for r in recs if r['task_type'] == 'out_of_scope')
+    nc_single = Counter(r['intents'][0]['intent'] for r in recs
+                        if r['task_type'] == 'single' and r.get('needs_clarification'))
+    registers = Counter()
+    for r in recs:
+        n = len(r['text'].split())
+        registers['very_short_1_3_words'] += n <= 3
+        registers['short_4_7_words'] += 4 <= n <= 7
+        registers['medium_8_14_words'] += 8 <= n <= 14
+        registers['long_15_plus_words'] += n >= 15
+    return {
+        'generated_at': EXECUTED_AT,
+        'source_file': {'path': 'kandoo_intent_dataset_v0.2.jsonl', 'sha256': sha256_of(DATASET)},
+        'total_records': len(recs),
+        'task_type_counts': dict(by_tt),
+        'unique_intents': len(slot_intents),
+        'intent_slots_total': sum(slot_intents.values()),
+        'slots_per_intent': dict(slot_intents),
+        'entity_values_total': sum(ent_types.values()),
+        'entity_values_per_type': dict(ent_types),
+        'date_value_distribution': dict(date_vals.most_common()),
+        'needs_clarification_total': sum(nc_by_tt.values()),
+        'needs_clarification_by_task_type': dict(nc_by_tt),
+        'clarification_reasons': dict(nc_reasons),
+        'nc_single_per_intent': dict(nc_single),
+        'ambiguity_candidate_pairs': dict(cand_pairs),
+        'oos_categories': dict(oos_cats),
+        'text_length_registers': dict(registers),
+    }
+
+
+# ================================================================ human review priority
+def human_review_priority(recs, ledger, stage_c_flags, near_dup_pairs):
+    hr_ids = []
+    per_id_batches = {}
+    for b in ledger['batch_log']:
+        for rid in b.get('human_review_priority', []):
+            hr_ids.append(rid)
+            per_id_batches.setdefault(rid, []).append(b['batch'])
+    hr_unique = sorted(set(hr_ids))
+
+    multi = {r['id']: r for r in recs if r['task_type'] == 'multi'}
+    stage_c_ids = sorted({f['id'] for f in stage_c_flags if f['id'] != '-'})
+    near_dup_members = sorted({p['a'] for p in near_dup_pairs} | {p['b'] for p in near_dup_pairs})
+
+    def reasons(rid):
+        rs = []
+        if rid in WARNING_REGISTRY_IDS:
+            rs.append('documented warning-registry record (phrase-valued date/period)')
+        if rid in CANON_EXCEPTION_IDS:
+            rs.append('canonical_value_exceptions registry (entity deviates from text by ratified rule)')
+        if rid in stage_c_ids:
+            rs.append('stage-C semantic flag (adjudicated by-design; re-verify at human pass)')
+        if rid in near_dup_members:
+            rs.append('member of a near-duplicate pair >= 0.75 (designed minimal pair / register variant)')
+        r = next((x for x in recs if x['id'] == rid), None)
+        if r:
+            if r['task_type'] == 'ambiguous':
+                rs.append('ambiguous record (clarification design)')
+            if r.get('needs_clarification') and r['task_type'] == 'single':
+                rs.append('single + needs_clarification (convention-relevant shape)')
+            if r['task_type'] == 'multi' and rid in multi:
+                labs = [s['intent'] for s in r['intents']]
+                if any(s.get('depends_on') is not None for s in r['intents']):
+                    rs.append('multi dependency chain')
+                if len(labs) != len(set(labs)):
+                    rs.append('multi repeated-intent')
+                if r.get('needs_clarification'):
+                    rs.append('multi + needs_clarification')
+            if r['task_type'] == 'out_of_scope':
+                rs.append('OOS boundary sample')
+        return rs or ['production-time priority mark (see batch_log notes)']
+
+    entries = [{'id': rid, 'flagged_in_batches': sorted(set(per_id_batches[rid])),
+                'task_type': next((x['task_type'] for x in recs if x['id'] == rid), None),
+                'review_reasons': reasons(rid)} for rid in hr_unique]
+
+    flagged_not_in_list = [rid for rid in stage_c_ids if rid not in set(hr_unique)]
+
+    return {
+        'generated_at': EXECUTED_AT,
+        'total_unique_records': len(hr_unique),
+        'note': 'All 398 records carry review_status=seed_needs_review; this list is the '
+                'accumulated production-time PRIORITY list from the 22 batch_log entries. '
+                'Every record remains subject to the mandatory human review before v0.3.',
+        'records': entries,
+        'supplementary_stage_c_flagged_not_in_priority': {
+            'ids': flagged_not_in_list,
+            'count': len(flagged_not_in_list),
+            'note': 'records carrying a stage-C semantic flag that are NOT in the production '
+                    'priority list - audit finding; recommend adding them to the human pass'},
+    }
+
+
+# ================================================================ main
+def main():
+    os.makedirs(REPORTS_DIR, exist_ok=True)
+    # NOTE: stage_c/stage_d subprocess runs write their RAW evidence to
+    # reports/stage_{c,d}_report_raw.json; this runner wraps them into the
+    # uniform reports/qc_stage_{c,d}_report.json files.
+    print('Kandoo Intent Dataset v0.2 - delivery audit runner')
+    print('executed_at_utc: %s' % EXECUTED_AT)
+    print('dataset        : %s' % DATASET)
+
+    recs, invalid_lines = load_jsonl(DATASET)
+    ledger = json.load(open(LEDGER_PATH, encoding='utf-8'))
+    print('records loaded : %d (invalid JSON lines: %d)' % (len(recs), len(invalid_lines)))
+
+    integ = file_integrity()
+    print('[1] file integrity: concat==final bytes: %s | id multiset: %s' % (
+        integ['concat_equals_final_exact_bytes'], integ['concat_equals_final_id_multiset']))
+
+    sa = stage_a_report()
+    print('[2] stage A: %s (errors=%d, warnings=%d)' % (sa['result'], sa['errors'], sa['warnings']))
+
+    sb = stage_b_report(recs, ledger, hist_preflight_path=os.path.join(
+        SCRIPT_DIR, 'historical_stage_b_preflight.json'))
+    print('[3] stage B: %s (exact=%d, ge0.90=%d, ge0.75=%d, max same-sig %.3f)' % (
+        sb['automated_result'], sb['exact_duplicates'], sb['pairs_ge_090'],
+        sb['pairs_ge_075'], sb['max_same_signature_similarity']))
+
+    sc = stage_c_report()
+    print('[4] stage C: automated %s (%d flags for human review)' % (sc['automated_result'], sc['flags']))
+
+    sd = stage_d_report()
+    print('[5] stage D: %s (%s)' % (sd['result'], sd['claims_audit']))
+
+    near_dup_pairs = [{'a': p['a'], 'b': p['b'], 'similarity': p['similarity']} for p in sb['pairs_ge_075_details']]
+    cv = claims_verification(recs, ledger, sa, {'pairs_ge_075': near_dup_pairs})
+    print('[6] claims verification: %d/%d MATCH' % (
+        sum(1 for c in cv['claims'] if c['status'] == 'MATCH'), len(cv['claims'])))
+    for m in cv['mismatches']:
+        print('    MISMATCH %s %s: claimed=%r actual=%r' % (m['id'], m['claim'], m['claimed'], m['actual']))
+
+    mi = multi_intent_audit(recs)
+    print('[7] multi-intent audit: %s (legality errors=%d, cycles=%d, M-0024 violations=%d)' % (
+        mi['result'], len(mi['depends_on_legality_errors']),
+        len(mi['depends_on_cycles']), len(mi['m0024_rule_violations'])))
+
+    stats = dataset_statistics(recs, ledger)
+    hrp = human_review_priority(recs, ledger, sc['flag_details'], sb['pairs_ge_075_details'])
+    print('[8] statistics + human-review list built (%d priority records, %d supplementary)' % (
+        hrp['total_unique_records'], hrp['supplementary_stage_c_flagged_not_in_priority']['count']))
+
+    master = {
+        'audit_meta': {
+            'runner': 'delivery_audit.py', 'runner_version': VERSION,
+            'runner_sha256': sha256_of(os.path.abspath(__file__)),
+            'executed_at_utc': EXECUTED_AT,
+            'dataset_file': 'kandoo_intent_dataset_v0.2.jsonl',
+            'dataset_sha256': sha256_of(DATASET),
+            'python': sys.version.split()[0],
+        },
+        'file_integrity': integ,
+        'json_validity': {'invalid_json_lines': invalid_lines, 'all_lines_valid_json': not invalid_lines},
+        'claims_verification': cv,
+        'qc_stage_a': sa,
+        'qc_stage_b': sb,
+        'qc_stage_c': sc,
+        'qc_stage_d': sd,
+        'multi_intent_audit': mi,
+        'overall_result': 'PASS' if (
+            integ['concat_equals_final_exact_bytes'] and not invalid_lines
+            and cv['all_match'] and sa['result'] == 'PASS'
+            and sb['automated_result'] == 'PASS' and sc['automated_result'] == 'PASS'
+            and sd['result'] == 'PASS' and mi['result'] == 'PASS') else 'FAIL',
+        'human_review_caveat': 'PASS above covers the automated checks only. Semantic '
+                               'adjudication of stage-C flags and designed-pair status of the 31 '
+                               'near-duplicate pairs remain HUMAN-REVIEW-REQUIRED (documented '
+                               'adjudications live in _progress.json).',
+    }
+
+    for name, payload in (('qc_stage_a_report.json', sa), ('qc_stage_b_report.json', sb),
+                          ('qc_stage_c_report.json', sc), ('qc_stage_d_report.json', sd),
+                          ('dataset_statistics.json', stats),
+                          ('human_review_priority.json', hrp),
+                          ('delivery_audit.json', master)):
+        with open(os.path.join(REPORTS_DIR, name), 'w', encoding='utf-8') as f:
+            json.dump(payload, f, ensure_ascii=False, indent=1)
+        print('  wrote reports/%s' % name)
+    print('OVERALL (automated): %s' % master['overall_result'])
+
+
+if __name__ == '__main__':
+    main()
