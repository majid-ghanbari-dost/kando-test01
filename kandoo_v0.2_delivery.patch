+        ('C24', 'ledger per_intent_counts matches actual', True, _per_intent_check(recs, ledger)),
+        ('C25', 'ledger id_counters match actual per prefix', True, _id_counter_check(recs, ledger)),
+    ]
+    table = []
+    for cid, desc, claimed, actual in claims:
+        table.append({'id': cid, 'claim': desc, 'claimed': claimed, 'actual': actual,
+                      'status': 'MATCH' if claimed == actual else 'MISMATCH'})
+    return {'claims': table,
+            'all_match': all(c['status'] == 'MATCH' for c in table),
+            'mismatches': [c for c in table if c['status'] != 'MATCH']}
