+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+Kandoo Intent Dataset v0.2 — Delivery Audit Runner (re-execution tool).
+
+Re-executes every QC check on the FINAL delivered file and verifies every
+number claimed in the mission report. Produces the uniform QC stage reports
+(A/B/C/D), the statistics file, the human-review priority list and the master
+delivery_audit.json evidence file.
+
+Checks implemented (mirrors the delivery contract):
+  1.  structural validation of every record        -> runs validate_batch.py
+  2.  record counts + intent distribution          -> in-process recount
+  3.  duplicate / missing IDs                      -> in-process recount
+  4.  invalid JSON detection                       -> per-line json.loads
+  5.  entity-vs-text evidence consistency          -> runs stage_c_semantic_pass.py
+  6.  depends_on + slot ordering legality          -> in-process + stage C
+  7.  clarification-field consistency              -> in-process + stage C
+  8.  ambiguous / out-of-scope record shape        -> in-process + stage A
+  9.  exact / near-duplicate sweep                 -> in-process (Stage B logic)
+  10. reproduction of final-report statistics      -> in-process recount
+
+Notes on honest reporting:
+  - automated checks that PASS are marked PASS;
+  - checks requiring human judgement (semantic adjudication of stage-C flags,
+    designed-minimal-pair adjudication of near-dup pairs >= 0.75) are marked
+    HUMAN_REVIEW_REQUIRED with the evidence listed;
+  - every report carries: script name, script sha256, execution timestamp,
+    input file + sha256, record count, error/warning counts, details, result.
+
+Usage (from anywhere; paths resolve relative to this file):
+    python3 delivery_audit.py
+
+Outputs (into ../reports/):
+    qc_stage_a_report.json, qc_stage_b_report.json, qc_stage_c_report.json,
+    qc_stage_d_report.json, dataset_statistics.json,
+    human_review_priority.json, delivery_audit.json
+"""
+import datetime
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+from collections import Counter
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+V02_DIR = os.path.dirname(SCRIPT_DIR)
+DATASET = os.path.join(V02_DIR, 'kandoo_intent_dataset_v0.2.jsonl')
+BATCHES_DIR = os.path.join(V02_DIR, 'batches')
+REJECTED_DIR = os.path.join(V02_DIR, 'rejected_drafts')
+LEDGER_PATH = os.path.join(V02_DIR, '_progress.json')
+REPORTS_DIR = os.path.join(V02_DIR, 'reports')
+
+sys.path.insert(0, SCRIPT_DIR)
+from farsi import normalize, similarity  # noqa: E402
+
+INTENTS = {'GET_SALES_REPORT', 'GET_PRODUCT_SALES', 'GET_PRODUCT_STOCK', 'GET_LOW_STOCK',
+           'SEARCH_PRODUCT', 'GET_LAST_INVOICE', 'SEARCH_INVOICE', 'GET_CUSTOMER_INFO',
+           'SEARCH_CUSTOMER', 'GET_TOP_PRODUCTS', 'GET_SALES_COMPARISON', 'GET_DAILY_SUMMARY'}
+CHAINABLE = {'product_name', 'customer_name', 'invoice_number', 'customer_id', 'phone'}
+DATE_FIELDS = {'date', 'date_range', 'period_a', 'period_b'}
+
+# documented warning registry (9 warnings, 3 families) — mirrors stage_c_semantic_pass.py
+WARNING_REGISTRY_IDS = ['KND-S-0024', 'KND-S-0025', 'KND-S-0057', 'KND-S-0062',
+                        'KND-S-0067', 'KND-S-0166', 'KND-S-0211', 'KND-S-0223']
+CANON_EXCEPTION_IDS = {'KND-S-0049', 'KND-S-0107', 'KND-S-0268', 'KND-S-0059', 'KND-S-0073',
+                       'KND-S-0052', 'KND-S-0077', 'KND-S-0045', 'KND-S-0078', 'KND-S-0085',
+                       'KND-S-0074', 'KND-S-0076'}
