+        hr_ids.extend(b.get('human_review_priority', []))
+    hr_unique = sorted(set(hr_ids))
+
+    multi = [r for r in recs if r['task_type'] == 'multi']
+    slot_hist = Counter(len(r['intents']) for r in multi)
+    chained = [r['id'] for r in multi if any(s.get('depends_on') is not None for s in r['intents'])]
+    multi_dep = [r['id'] for r in multi
+                 if sum(1 for s in r['intents'] if s.get('depends_on') is not None) >= 2]
+    repeated = [r['id'] for r in multi
+                if len([s['intent'] for s in r['intents']]) != len({s['intent'] for s in r['intents']})]
+    multi_nc = [r['id'] for r in multi if r.get('needs_clarification')]
+
+    claims = [
+        ('C01', 'total records', 398, len(recs)),
+        ('C02', 'single records', 272, by_tt.get('single', 0)),
+        ('C03', 'multi records', 53, by_tt.get('multi', 0)),
+        ('C04', 'ambiguous records', 23, by_tt.get('ambiguous', 0)),
+        ('C05', 'out-of-scope records', 50, by_tt.get('out_of_scope', 0)),
+        ('C06', 'unique intents', 12, len(used_intents)),
+        ('C07', 'intent slots', 391, slots),
+        ('C08', 'entity values', 385, ent_vals),
+        ('C09', 'records needing clarification', 49, nc_records),
+        ('C10', 'human-review priority records', 144, len(hr_unique)),
+        ('C11', 'closed convention decisions', 44,
+         len(ledger['pending_for_later_batches']['closed_convention_decisions'])),
+        ('C12', 'structural warnings (documented)', 9, stage_a_result['warnings']),
+        ('C13', 'near-duplicate pairs >= 0.75', 31, len(near_dup['pairs_ge_075'])),
+        ('C14', 'multi records with 2 slots', 43, slot_hist.get(2, 0)),
+        ('C15', 'multi records with 3 slots', 8, slot_hist.get(3, 0)),
+        ('C16', 'multi records with 4 slots', 1, slot_hist.get(4, 0)),
+        ('C17', 'multi records with 5 slots', 1, slot_hist.get(5, 0)),
+        ('C18', 'dependency chains (multi records with >=1 depends_on)', 12, len(chained)),
+        ('C19', 'multi-dependent records (>=2 depends_on edges)', 3, len(multi_dep)),
+        ('C20', 'records with repeated intent + different entities', 19, len(repeated)),
+        ('C21', 'multi records carrying needs_clarification', 1, len(multi_nc)),
+        ('C22', 'ledger total_samples', 398, ledger['total_samples']),
+        ('C23', 'ledger per_task_type_counts matches actual', True,
